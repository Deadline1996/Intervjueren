{
  "name": "fivem-recorder",
  "productName": "Intervjueren",
  "version": "1.0.0",
  "description": "Intervjueren – lett skjerm- og lydopptaker med overlegg for FiveM-intervjuer",
  "main": "src/main.js",
  "author": "Dan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "no.intervjueren.app",
    "productName": "Intervjueren",
    "files": [
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
