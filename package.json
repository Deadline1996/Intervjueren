{
  "name": "fivem-recorder",
  "productName": "Intervjueren",
  "version": "2.0.0",
  "description": "Intervjueren – lett skjerm- og lydopptaker med overlegg for FiveM-intervjuer",
  "main": "src/main.js",
  "author": "Dan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "engine": "node scripts/build-engine.js",
    "ffmpeg": "node scripts/fetch-ffmpeg.js",
    "prepack": "node scripts/fetch-ffmpeg.js",
    "pack": "electron-builder --win dir",
    "predist": "node scripts/fetch-ffmpeg.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "no.intervjueren.app",
    "productName": "Intervjueren",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Intervjueren",
      "installerLanguages": [
        "nb_NO"
      ],
      "language": "1044",
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Intervjueren",
      "artifactName": "Intervjueren-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "intervjueren-engine.exe",
          "ffmpeg.exe",
          "ffmpeg-LICENSE.txt"
        ]
      }
    ]
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
